# Copy this file to .env and fill in real values.
# .env is never committed to git.

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Set on first boot to create the admin user.
# To reset credentials: update these values and run: docker compose up -d
# After initial setup you can remove ADMIN_USER/ADMIN_PASSWORD — the DB retains them.
ADMIN_USER=admin
ADMIN_PASSWORD=
